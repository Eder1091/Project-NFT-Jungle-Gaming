# Ativa a camada de mocks (MSW) no navegador. Mantido ligado também no build de demonstração.
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks: default | empty | slow | flaky | catalog-error | session-expired | price-change | payment-declined | order-timeout
# Também aceito na URL: ?mock-scenario=slow
VITE_MOCK_SCENARIO=default
